{%- comment -%}
  Page header — the banner that opens every inner page: a large title
  over an image, with a breadcrumb trail. The trail is also emitted as
  BreadcrumbList JSON-LD so the crumbs can show in search results.
{%- endcomment -%}

{%- liquid
  assign page_type = request.page_type
  assign title = section.settings.heading

  if title == blank
    case page_type
      when 'collection'
        assign title = collection.title
      when 'product'
        assign title = product.title
      when 'article'
        assign title = article.title
      when 'blog'
        assign title = blog.title
      when 'page'
        assign title = page.title
      when 'search'
        assign title = 'templates.search.title' | t
      when 'customers/account'
        assign title = 'customer.account.title' | t
      when '404'
        assign title = 'general.404.title' | t
      else
        assign title = shop.name
    endcase
  endif

  assign image = section.settings.image
  if image == blank
    case page_type
      when 'collection'
        assign image = collection.image
      when 'article'
        assign image = article.image
    endcase
  endif
-%}

<div
  class="page-header color-{{ section.settings.color_scheme }} color-scheme{% unless image == blank %} page-header--has-image{% endunless %}"
  style="--page-header-height: {{ section.settings.height }}px; --overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
>
  {%- unless image == blank -%}
    <div class="page-header__media">
      {{
        image
        | image_url: width: 3000
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          widths: '750, 1100, 1500, 2000, 2400, 3000',
          sizes: '100vw',
          alt: ''
      }}
    </div>
  {%- endunless -%}

  <div class="page-width">
    <div class="page-header__content" style="text-align: {{ section.settings.alignment }};">
      {%- if section.settings.use_as_page_title -%}
        <h1 class="page-header__title h1">{{ title }}</h1>
      {%- else -%}
        <p class="page-header__title h1">{{ title }}</p>
      {%- endif -%}

      {%- if section.settings.show_breadcrumb -%}
        <nav class="breadcrumb" aria-label="{{ 'general.breadcrumb.label' | t }}">
          <ol class="breadcrumb__list">
            <li class="breadcrumb__item">
              <a href="{{ routes.root_url }}">{{ 'general.breadcrumb.home' | t }}</a>
            </li>

            {%- case page_type -%}
              {%- when 'collection' -%}
                {%- unless collection.handle == blank -%}
                  <li class="breadcrumb__item" aria-current="page">{{ collection.title }}</li>
                {%- endunless -%}

              {%- when 'product' -%}
                {%- unless collection == blank -%}
                  <li class="breadcrumb__item">
                    <a href="{{ collection.url }}">{{ collection.title }}</a>
                  </li>
                {%- endunless -%}
                <li class="breadcrumb__item" aria-current="page">{{ product.title }}</li>

              {%- when 'article' -%}
                <li class="breadcrumb__item">
                  <a href="{{ blog.url }}">{{ blog.title }}</a>
                </li>
                <li class="breadcrumb__item" aria-current="page">{{ article.title }}</li>

              {%- when 'blog' -%}
                <li class="breadcrumb__item" aria-current="page">{{ blog.title }}</li>

              {%- when 'page' -%}
                <li class="breadcrumb__item" aria-current="page">{{ page.title }}</li>

              {%- else -%}
                <li class="breadcrumb__item" aria-current="page">{{ title }}</li>
            {%- endcase -%}
          </ol>
        </nav>
      {%- endif -%}
    </div>
  </div>
</div>

{%- if section.settings.show_breadcrumb -%}
  {%- capture breadcrumb_items -%}
    {"@type":"ListItem","position":1,"name":{{ 'general.breadcrumb.home' | t | json }},"item":{{ shop.url | append: routes.root_url | json }}}
    {%- case page_type -%}
      {%- when 'collection' -%}
        {%- unless collection.handle == blank -%}
          ,{"@type":"ListItem","position":2,"name":{{ collection.title | json }},"item":{{ shop.url | append: collection.url | json }}}
        {%- endunless -%}
      {%- when 'product' -%}
        {%- if collection == blank -%}
          ,{"@type":"ListItem","position":2,"name":{{ product.title | json }},"item":{{ shop.url | append: product.url | json }}}
        {%- else -%}
          ,{"@type":"ListItem","position":2,"name":{{ collection.title | json }},"item":{{ shop.url | append: collection.url | json }}}
          ,{"@type":"ListItem","position":3,"name":{{ product.title | json }},"item":{{ shop.url | append: product.url | json }}}
        {%- endif -%}
      {%- when 'article' -%}
        ,{"@type":"ListItem","position":2,"name":{{ blog.title | json }},"item":{{ shop.url | append: blog.url | json }}}
        ,{"@type":"ListItem","position":3,"name":{{ article.title | json }},"item":{{ shop.url | append: article.url | json }}}
      {%- when 'blog' -%}
        ,{"@type":"ListItem","position":2,"name":{{ blog.title | json }},"item":{{ shop.url | append: blog.url | json }}}
      {%- when 'page' -%}
        ,{"@type":"ListItem","position":2,"name":{{ page.title | json }},"item":{{ shop.url | append: page.url | json }}}
    {%- endcase -%}
  {%- endcapture -%}
  <script type="application/ld+json">
    {"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{{ breadcrumb_items }}]}
  </script>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.page_header.name",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.page_header.settings.heading.label",
      "info": "t:sections.page_header.settings.heading.info"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.page_header.settings.image.label",
      "info": "t:sections.page_header.settings.image.info"
    },
    {
      "type": "range",
      "id": "height",
      "min": 160,
      "max": 560,
      "step": 20,
      "unit": "px",
      "label": "t:sections.page_header.settings.height.label",
      "default": 340
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "t:sections.page_header.settings.overlay_opacity.label",
      "default": 35
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "t:sections.page_header.settings.alignment.label",
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "use_as_page_title",
      "label": "t:sections.page_header.settings.use_as_page_title.label",
      "info": "t:sections.page_header.settings.use_as_page_title.info",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "t:sections.page_header.settings.show_breadcrumb.label",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.page_header.settings.color_scheme.label",
      "default": "scheme_2"
    }
  ],
  "presets": [
    {
      "name": "t:sections.page_header.presets.preset__1.name"
    }
  ]
}
{% endschema %}
