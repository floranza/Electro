{%- comment -%}
  Tabbed collections — the "Browse by genre" grid, where each tab is a
  collection. Every panel is rendered server-side so the grid works with
  JavaScript disabled and there is no request when switching tabs.
{%- endcomment -%}

{%- liquid
  assign limit = section.settings.products_to_show
  assign uid = section.id | replace: '_', '-'
-%}

<section class="section color-{{ section.settings.color_scheme }} color-scheme">
  <div class="page-width">
    <div class="section-header section-header--stacked">
      <div class="section-header__text">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="{{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <p>{{ section.settings.description }}</p>
        {%- endif -%}
      </div>
    </div>

    {%- if section.blocks.size > 0 -%}
      <collection-tabs class="tabs">
        <div class="tabs__nav" role="tablist" aria-label="{{ section.settings.heading | default: 'Collections' | escape }}">
          {%- for block in section.blocks -%}
            {%- liquid
              assign block_collection = block.settings.collection
              assign label = block.settings.label
              if label == blank
                assign label = block_collection.title
              endif
              if label == blank
                assign label = 'Collection'
              endif
            -%}
            <button
              class="tabs__tab"
              role="tab"
              type="button"
              id="tab-{{ uid }}-{{ forloop.index }}"
              aria-controls="panel-{{ uid }}-{{ forloop.index }}"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
              {{ block.shopify_attributes }}
            >
              {{ label | escape }}
            </button>
          {%- endfor -%}
        </div>

        {%- for block in section.blocks -%}
          {%- assign block_collection = block.settings.collection -%}
          <div
            class="tabs__panel"
            role="tabpanel"
            id="panel-{{ uid }}-{{ forloop.index }}"
            aria-labelledby="tab-{{ uid }}-{{ forloop.index }}"
            {% unless forloop.first %}hidden{% endunless %}
          >
            <div class="grid grid--products" style="--columns: {{ section.settings.columns }}; --columns-mobile: {{ section.settings.columns_mobile }};">
              {%- for product in block_collection.products limit: limit -%}
                <div data-animate>
                  {% render 'product-card', product: product, sizes: '(min-width: 990px) 25vw, 50vw' %}
                </div>
              {%- else -%}
                {%- for i in (1..limit) -%}
                  <div>{% render 'product-card' %}</div>
                {%- endfor -%}
              {%- endfor -%}
            </div>

            {%- if section.settings.show_view_all and block_collection != blank -%}
              <div class="tabs__footer">
                <a href="{{ block_collection.url }}" class="button button--outline button--small">
                  {{ section.settings.view_all_label | default: 'View all' }}
                </a>
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </collection-tabs>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.tabbed_collections.name",
  "tag": "section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.tabbed_collections.settings.eyebrow.label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.tabbed_collections.settings.heading.label",
      "default": "Popular products"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:sections.tabbed_collections.settings.heading_size.label",
      "options": [
        { "value": "h3", "label": "t:sections.tabbed_collections.settings.heading_size.options__1.label" },
        { "value": "h2", "label": "t:sections.tabbed_collections.settings.heading_size.options__2.label" },
        { "value": "h1", "label": "t:sections.tabbed_collections.settings.heading_size.options__3.label" }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:sections.tabbed_collections.settings.description.label"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "t:sections.tabbed_collections.settings.products_to_show.label",
      "default": 4
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "t:sections.tabbed_collections.settings.columns.label",
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:sections.tabbed_collections.settings.columns_mobile.label",
      "options": [
        { "value": "1", "label": "t:sections.tabbed_collections.settings.columns_mobile.options__1.label" },
        { "value": "2", "label": "t:sections.tabbed_collections.settings.columns_mobile.options__2.label" }
      ],
      "default": "2"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "t:sections.tabbed_collections.settings.show_view_all.label",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "t:sections.tabbed_collections.settings.view_all_label.label",
      "default": "View all"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.tabbed_collections.settings.color_scheme.label",
      "default": "scheme_1"
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "t:sections.tabbed_collections.blocks.tab.name",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:sections.tabbed_collections.blocks.tab.settings.collection.label"
        },
        {
          "type": "text",
          "id": "label",
          "label": "t:sections.tabbed_collections.blocks.tab.settings.label.label",
          "info": "t:sections.tabbed_collections.blocks.tab.settings.label.info"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.tabbed_collections.presets.preset__1.name",
      "blocks": [{ "type": "tab" }, { "type": "tab" }, { "type": "tab" }]
    }
  ]
}
{% endschema %}
